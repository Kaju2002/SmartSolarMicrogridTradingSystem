<?xml version="1.0" encoding="utf-8"?>
<!-- One code digit box: gold border when focused, light grey otherwise -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1.5dp" android:color="@color/accent_gold" />
            <corners android:radius="@dimen/otp_box_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/field_border" />
            <corners android:radius="@dimen/otp_box_radius" />
        </shape>
    </item>
</selector>
