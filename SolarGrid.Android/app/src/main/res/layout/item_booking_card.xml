<?xml version="1.0" encoding="utf-8"?>
<!--
    File: item_booking_card.xml
    Module: Reservation Management (Kajanthan)
    Description: One booking in the Bookings list: station, status pill, slot time and energy.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/home_card_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBookingStation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold"
                tools:text="Colombo Fort Solar Hub" />

            <TextView
                android:id="@+id/tvBookingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/booking_pending_bg"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/booking_pending"
                android:textSize="@dimen/text_small"
                android:textStyle="bold"
                tools:text="Pending" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBookingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawablePadding="@dimen/space_sm"
            android:gravity="center_vertical"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_row_subtitle"
            app:drawableStartCompat="@drawable/ic_schedule"
            app:drawableTint="@color/text_hint"
            tools:text="Tue, 29 Sep · 09:00 – 10:00" />

        <TextView
            android:id="@+id/tvBookingEnergy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="@dimen/space_sm"
            android:gravity="center_vertical"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_row_subtitle"
            app:drawableStartCompat="@drawable/ic_bolt"
            app:drawableTint="@color/text_hint"
            tools:text="10 kWh · Estimated LKR 450" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
