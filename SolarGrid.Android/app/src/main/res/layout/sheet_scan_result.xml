<?xml version="1.0" encoding="utf-8"?>
<!--
    File: sheet_scan_result.xml
    Module: Verification and Dashboard (Aaron)
    Description: QR scan bottom sheet. Verify shows the booking from the server (station, time,
                 NIC, name, kWh, cost) with Confirm transfer; success shows the completed booking;
                 failure shows the API's reason.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Circle tint and icon are set in code: green tick or red cross -->
        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_white_circle"
            android:importantForAccessibility="no"
            android:padding="18dp"
            tools:backgroundTint="@color/station_open_bg"
            tools:src="@drawable/ic_check"
            tools:tint="@color/station_open" />

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="@string/scan_success_title" />

        <TextView
            android:id="@+id/tvResultMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            tools:text="@string/scan_success_message" />

        <!-- Booking details; verify and success only -->
        <LinearLayout
            android:id="@+id/layoutResultDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvResultStation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Malabe Solar Hub" />

                <TextView
                    android:id="@+id/tvResultStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textSize="@dimen/text_small"
                    android:textStyle="bold"
                    tools:text="@string/booking_status_completed" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvResultTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                tools:text="Wed, 30 Sep · 10:00 – 11:00" />

            <!-- Prosumer name shows only when verifying, so the operator can match the person -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/infoNic"
                    layout="@layout/item_station_info" />

                <Space
                    android:id="@+id/spaceName"
                    android:layout_width="12dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <include
                    android:id="@+id/infoName"
                    layout="@layout/item_station_info"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/infoEnergy"
                    layout="@layout/item_station_info" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp" />

                <include
                    android:id="@+id/infoCost"
                    layout="@layout/item_station_info" />
            </LinearLayout>
        </LinearLayout>

        <!-- Confirm transfer while verifying; Scan next / Scan again after -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanNext"
            style="@style/Widget.SolarGrid.Button.Primary"
            android:layout_marginTop="@dimen/space_lg"
            tools:text="@string/scan_confirm" />

        <!-- "Not now" while verifying: closes without completing -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanDismiss"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/scan_not_now"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
