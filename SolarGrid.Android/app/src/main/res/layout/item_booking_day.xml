<?xml version="1.0" encoding="utf-8"?>
<!--
    File: item_booking_day.xml
    Module: Reservation Management (Kajanthan)
    Description: One day chip on the booking screen: weekday, date and month.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/booking_day_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_sm"
    android:background="@drawable/bg_booking_chip"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tvDayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textColor="@color/booking_chip_subtext"
        android:textSize="@dimen/text_small"
        tools:text="Today" />

    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:duplicateParentState="true"
        android:textColor="@color/booking_chip_text"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="29" />

    <TextView
        android:id="@+id/tvDayMonth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textColor="@color/booking_chip_subtext"
        android:textSize="@dimen/text_station_label"
        tools:text="Sep" />
</LinearLayout>
