<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_book_slot.xml
    Module: Reservation Management (Kajanthan)
    Description: Booking screen: station summary, day chips, hourly time grid,
                 and a bottom bar with the picked slot and Confirm booking.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="@dimen/screen_padding">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/booking_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/booking_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                android:id="@+id/tvStationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/screen_padding"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Colombo Fort Solar Hub" />

            <TextView
                android:id="@+id/tvStationFacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginEnd="@dimen/screen_padding"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                tools:text="06:00 – 20:00 · LKR 45 per kWh" />

            <!-- Change mode: the booking's current time and kWh -->
            <TextView
                android:id="@+id/tvChangeNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/screen_padding"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/surface_soft"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_small"
                android:visibility="gone"
                tools:text="Now: Mon, 28 Sep · 07:00 – 08:00 · 5 kWh"
                tools:visibility="visible" />

            <TextView
                style="@style/Widget.SolarGrid.SectionLabel"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/booking_label_date" />

            <!-- Day chips scroll edge to edge but line up with the text -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                tools:itemCount="7"
                tools:listitem="@layout/item_booking_day" />

            <TextView
                style="@style/Widget.SolarGrid.SectionLabel"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/booking_label_time" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="160dp"
                android:paddingStart="@dimen/booking_grid_padding"
                android:paddingEnd="@dimen/booking_grid_padding">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSlots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="9"
                    tools:listitem="@layout/item_booking_slot" />

                <ProgressBar
                    android:id="@+id/progressSlots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/accent_gold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutSlotsMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSlotsMessage"
                        style="@style/Widget.SolarGrid.EmptyText"
                        tools:text="@string/booking_no_slots" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetrySlots"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/booking_retry"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/field_border" />
                </LinearLayout>
            </FrameLayout>

            <!-- Energy picker, shown once a time is picked -->
            <LinearLayout
                android:id="@+id/layoutEnergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Widget.SolarGrid.SectionLabel"
                    android:layout_marginStart="@dimen/screen_padding"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/booking_label_energy" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_padding"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="@dimen/screen_padding"
                    android:background="@drawable/bg_info_tile"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnKWhMinus"
                            style="@style/Widget.SolarGrid.StepperButton"
                            android:contentDescription="@string/booking_kwh_less"
                            android:text="@string/booking_minus" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvKWh"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                tools:text="10 kWh" />

                            <TextView
                                android:id="@+id/tvEstimatedCost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp"
                                tools:text="Estimated LKR 450" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnKWhPlus"
                            style="@style/Widget.SolarGrid.StepperButton"
                            android:contentDescription="@string/booking_kwh_more"
                            android:text="@string/booking_plus" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderKWh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:contentDescription="@string/booking_label_energy"
                        android:stepSize="1"
                        android:valueFrom="1"
                        android:valueTo="40"
                        app:labelBehavior="gone"
                        app:thumbColor="@color/text_primary"
                        app:trackColorActive="@color/accent_gold"
                        app:trackColorInactive="@color/field_border" />

                    <TextView
                        android:id="@+id/tvKWhHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small"
                        tools:text="1 – 40 kWh free at 09:00" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom bar: picked slot and Confirm -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_soft" />

    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_md">

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/booking_pick_slot"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/Widget.SolarGrid.Button.Primary"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/booking_confirm" />
    </LinearLayout>
</LinearLayout>
