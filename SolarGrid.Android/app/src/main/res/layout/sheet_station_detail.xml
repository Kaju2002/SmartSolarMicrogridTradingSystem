<?xml version="1.0" encoding="utf-8"?>
<!--
    File: sheet_station_detail.xml
    Module: Station Management (Gabilan)
    Description: Station detail bottom sheet: name, open/closed, distance, four fact tiles,
                 and the Directions and Book a slot buttons.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:paddingBottom="@dimen/space_lg">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Colombo Fort Solar Hub" />

        <TextView
            android:id="@+id/tvDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/station_open_bg"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="@color/station_open"
            android:textSize="@dimen/text_small"
            android:textStyle="bold"
            tools:text="@string/station_open_now" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDetailDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        tools:text="2.2 km away" />

    <!-- Four fact tiles in a 2 x 2 grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include
            android:id="@+id/infoHours"
            layout="@layout/item_station_info" />

        <Space
            android:layout_width="12dp"
            android:layout_height="0dp" />

        <include
            android:id="@+id/infoPrice"
            layout="@layout/item_station_info" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include
            android:id="@+id/infoSlots"
            layout="@layout/item_station_info" />

        <Space
            android:layout_width="12dp"
            android:layout_height="0dp" />

        <include
            android:id="@+id/infoCapacity"
            layout="@layout/item_station_info" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDirections"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="@string/station_directions"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:cornerRadius="@dimen/pill_radius"
            app:icon="@drawable/ic_directions"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/field_border" />

        <Space
            android:layout_width="12dp"
            android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookSlot"
            style="@style/Widget.SolarGrid.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1.3"
            android:text="@string/station_book_slot" />
    </LinearLayout>
</LinearLayout>
