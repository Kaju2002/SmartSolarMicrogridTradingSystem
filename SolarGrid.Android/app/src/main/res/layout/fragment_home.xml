<?xml version="1.0" encoding="utf-8"?>
<!--
    File: fragment_home.xml
    Module: Team
    Description: Home tab. Illustrated hero with greeting, feature cards,
                 "Your SolarGrid" shortcuts and a booking tip.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero: illustration fills the width; text sits on its empty sky -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_hero_height"
                android:background="@color/home_sky">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_home_hero" />

                <!-- Top padding (status bar) is added in code -->
                <LinearLayout
                    android:id="@+id/layoutHeroText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingTop="@dimen/space_md"
                    android:paddingEnd="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_home_greeting"
                            tools:text="Good evening, Kajanthan" />

                        <!-- Initials in a gold circle; opens the Profile tab -->
                        <TextView
                            android:id="@+id/tvAvatar"
                            android:layout_width="@dimen/home_avatar_size"
                            android:layout_height="@dimen/home_avatar_size"
                            android:layout_marginStart="@dimen/space_md"
                            android:background="@drawable/bg_avatar_circle"
                            android:clickable="true"
                            android:contentDescription="@string/home_avatar_description"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="KA" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:letterSpacing="-0.01"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/home_hero_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_home_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/home_hero_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_home_subtitle" />
                </LinearLayout>
            </FrameLayout>

            <!-- White sheet overlapping the bottom of the hero -->
            <LinearLayout
                android:id="@+id/layoutSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-28dp"
                android:background="@drawable/bg_home_sheet"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_lg">

                <!-- Live booking counts from the dashboard API; the whole card opens the dashboard -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginEnd="@dimen/space_lg"
                    android:layout_marginBottom="@dimen/space_xl"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/home_card_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/dashboard_title"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_card_title" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableEnd="@drawable/ic_chevron_right"
                                android:drawablePadding="2dp"
                                android:gravity="center_vertical"
                                android:text="@string/home_dashboard_open"
                                android:textColor="@color/text_hint"
                                android:textSize="@dimen/text_row_subtitle" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/tileHomePending"
                                layout="@layout/item_dashboard_count" />

                            <Space
                                android:layout_width="10dp"
                                android:layout_height="0dp" />

                            <include
                                android:id="@+id/tileHomeApproved"
                                layout="@layout/item_dashboard_count" />

                            <Space
                                android:layout_width="10dp"
                                android:layout_height="0dp" />

                            <include
                                android:id="@+id/tileHomeCompleted"
                                layout="@layout/item_dashboard_count" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Widget.SolarGrid.SectionLabel"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginBottom="12dp"
                    android:text="@string/home_section_start" />

                <!-- Feature cards, scroll sideways; the third one peeks in as a hint -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/cardFind"
                            layout="@layout/item_home_card"
                            android:layout_width="@dimen/home_card_width"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp" />

                        <include
                            android:id="@+id/cardBook"
                            layout="@layout/item_home_card"
                            android:layout_width="@dimen/home_card_width"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp" />

                        <include
                            android:id="@+id/cardQr"
                            layout="@layout/item_home_card"
                            android:layout_width="@dimen/home_card_width"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Your SolarGrid shortcuts, grouped in one soft grey card -->
                <TextView
                    style="@style/Widget.SolarGrid.SectionLabel"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginTop="@dimen/space_xl"
                    android:layout_marginBottom="12dp"
                    android:text="@string/home_section_yours" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginEnd="@dimen/space_lg"
                    app:cardBackgroundColor="@color/surface_soft"
                    app:cardCornerRadius="@dimen/home_card_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs">

                        <include
                            android:id="@+id/rowBookings"
                            layout="@layout/item_home_row" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/home_row_divider_inset"
                            android:background="@color/divider_soft" />

                        <include
                            android:id="@+id/rowHow"
                            layout="@layout/item_home_row" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/home_row_divider_inset"
                            android:background="@color/divider_soft" />

                        <include
                            android:id="@+id/rowWhy"
                            layout="@layout/item_home_row" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/home_row_divider_inset"
                            android:background="@color/divider_soft" />

                        <include
                            android:id="@+id/rowProfile"
                            layout="@layout/item_home_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Booking tip -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginTop="@dimen/space_lg"
                    android:layout_marginEnd="@dimen/space_lg"
                    app:cardBackgroundColor="@color/home_tip_bg"
                    app:cardCornerRadius="@dimen/home_card_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="@dimen/home_tip_image"
                            android:layout_height="@dimen/home_tip_image"
                            android:importantForAccessibility="no"
                            android:src="@drawable/img_home_tip" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/home_tip_title"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_card_title" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/home_tip_body"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_row_subtitle" />

                            <TextView
                                android:id="@+id/tvTipLink"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:background="?attr/selectableItemBackground"
                                android:drawableEnd="@drawable/ic_chevron_right"
                                android:drawablePadding="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_vertical"
                                android:paddingTop="@dimen/space_xs"
                                android:paddingBottom="@dimen/space_xs"
                                android:text="@string/home_tip_link"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_row_subtitle" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- White strip behind the status bar; fades in on scroll so content never runs under the clock.
         Height is set in code. -->
    <View
        android:id="@+id/viewStatusScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@color/white" />
</FrameLayout>
