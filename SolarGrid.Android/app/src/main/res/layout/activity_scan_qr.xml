<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_scan_qr.xml
    Module: Verification and Dashboard (Aaron)
    Description: Operator QR scanner: full-screen camera with a top bar (back, flash),
                 a bottom panel (hint, manual entry), a checking overlay and a
                 camera-permission screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".verification.operator.ScanQrActivity">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/barcodeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Status bar padding is added in code (edge-to-edge) -->
    <LinearLayout
        android:id="@+id/layoutScanTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/scan_scrim"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnScanBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/scan_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/scan_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Only on phones with a flash; keeps the title centred when hidden -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/btnTorch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/scan_torch_on"
                android:src="@drawable/ic_bolt"
                android:visibility="gone"
                app:tint="@color/white"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <!-- Navigation bar padding is added in code -->
    <LinearLayout
        android:id="@+id/layoutScanBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/scan_scrim"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/scan_hint"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManualEntry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/scan_manual"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="@dimen/pill_radius"
            app:strokeColor="@color/white" />
    </LinearLayout>

    <!-- Shown while the API checks the code -->
    <LinearLayout
        android:id="@+id/layoutVerifying"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scan_scrim"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/accent_gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/scan_verifying"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Camera permission missing: allow it, or type the code instead -->
    <FrameLayout
        android:id="@+id/layoutPermission"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnPermissionBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/scan_back"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <ImageView
                android:layout_width="@dimen/empty_icon_size"
                android:layout_height="@dimen/empty_icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_qr_scan"
                app:tint="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/scan_permission_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/scan_permission_message"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAllowCamera"
                style="@style/Widget.SolarGrid.Button.Primary"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/scan_permission_allow" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPermissionManual"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="12dp"
                android:text="@string/scan_manual"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:cornerRadius="@dimen/pill_radius"
                app:strokeColor="@color/field_border" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
