<?xml version="1.0" encoding="utf-8"?>
<!--
    File: item_onboarding_page.xml
    Module: Onboarding (shared)
    Description: One onboarding page. Full-screen photo with the white step card,
                 title, body, page dots and the gold next arrow.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:src="@drawable/img_onboarding_1" />

    <!-- Bottom margin grows in code by the navigation bar height -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/onboarding_card_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/onboarding_card_margin"
        android:layout_marginEnd="@dimen/onboarding_card_margin"
        android:layout_marginBottom="@dimen/onboarding_card_margin">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/bg_onboarding_card" />

        <!-- Text stays in the top block, left of the arrow tab -->
        <LinearLayout
            android:layout_width="@dimen/onboarding_text_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/onboarding_card_padding"
            android:layout_marginTop="@dimen/onboarding_card_padding"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_onboarding_title"
                android:textStyle="bold"
                tools:text="@string/onboarding_title_1" />

            <TextView
                android:id="@+id/tvBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:maxLines="3"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_small"
                tools:text="@string/onboarding_body_1" />

            <!-- Page dots; the current one is drawn wider and gold in code -->
            <LinearLayout
                android:id="@+id/llDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="@dimen/onboarding_dot_active_width"
                    android:layout_height="@dimen/onboarding_dot_size"
                    android:background="@drawable/bg_dot_active" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="@dimen/onboarding_dot_size"
                    android:layout_height="@dimen/onboarding_dot_size"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="@drawable/bg_dot_inactive" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="@dimen/onboarding_dot_size"
                    android:layout_height="@dimen/onboarding_dot_size"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="@drawable/bg_dot_inactive" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="@dimen/onboarding_arrow_size"
            android:layout_height="@dimen/onboarding_arrow_size"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/onboarding_arrow_margin_end"
            android:layout_marginBottom="@dimen/onboarding_arrow_margin_bottom"
            android:background="@drawable/bg_arrow_button"
            android:contentDescription="@string/onboarding_next"
            android:src="@drawable/ic_arrow_forward" />
    </FrameLayout>
</FrameLayout>
