<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_register.xml
    Module: Identity and Access (Vithusha)
    Description: Prosumer sign-up screen. New accounts wait for Backoffice approval.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".auth.RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero image with the same step edge as login -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/register_hero_height">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/img_register_hero" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/login_hero_edge_height"
                android:layout_gravity="bottom"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/bg_hero_step" />
        </FrameLayout>

        <!-- Sign-up form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/register_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <!-- Full name -->
            <TextView
                style="@style/Widget.SolarGrid.FieldLabel"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/etFullName"
                android:text="@string/full_name_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFullName"
                style="@style/Widget.SolarGrid.TextInputLayout.Pill"
                android:layout_marginTop="@dimen/space_sm"
                app:startIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFullName"
                    style="@style/Widget.SolarGrid.EditText.Pill"
                    android:hint="@string/full_name_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- NIC: old (9 digits + V/X) or new (12 digits) -->
            <TextView
                style="@style/Widget.SolarGrid.FieldLabel"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/etNic"
                android:text="@string/nic_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNic"
                style="@style/Widget.SolarGrid.TextInputLayout.Pill"
                android:layout_marginTop="@dimen/space_sm"
                app:startIconDrawable="@drawable/ic_badge">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNic"
                    style="@style/Widget.SolarGrid.EditText.Pill"
                    android:hint="@string/nic_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="12" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone -->
            <TextView
                style="@style/Widget.SolarGrid.FieldLabel"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/etPhone"
                android:text="@string/phone_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                style="@style/Widget.SolarGrid.TextInputLayout.Pill"
                android:layout_marginTop="@dimen/space_sm"
                app:startIconDrawable="@drawable/ic_phone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    style="@style/Widget.SolarGrid.EditText.Pill"
                    android:hint="@string/phone_hint"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:maxLength="15" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- E-mail -->
            <TextView
                style="@style/Widget.SolarGrid.FieldLabel"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/etEmail"
                android:text="@string/email_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.SolarGrid.TextInputLayout.Pill"
                android:layout_marginTop="@dimen/space_sm"
                app:startIconDrawable="@drawable/ic_email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    style="@style/Widget.SolarGrid.EditText.Pill"
                    android:hint="@string/email_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <TextView
                style="@style/Widget.SolarGrid.FieldLabel"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/etPassword"
                android:text="@string/password_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.SolarGrid.TextInputLayout.Pill"
                android:layout_marginTop="@dimen/space_sm"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    style="@style/Widget.SolarGrid.EditText.Pill"
                    android:hint="@string/password_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm password (checked on the phone so typos are caught before sending) -->
            <TextView
                style="@style/Widget.SolarGrid.FieldLabel"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/etConfirmPassword"
                android:text="@string/confirm_password_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                style="@style/Widget.SolarGrid.TextInputLayout.Pill"
                android:layout_marginTop="@dimen/space_sm"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    style="@style/Widget.SolarGrid.EditText.Pill"
                    android:hint="@string/confirm_password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Shown only when sign-up fails; RegisterActivity sets text and visibility -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textColor="@color/error_red"
                android:textSize="@dimen/text_small"
                android:visibility="gone"
                tools:text="Username or NIC already exists"
                tools:visibility="visible" />

            <!-- Button and spinner share one spot; spinner replaces the text while loading -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAccount"
                    style="@style/Widget.SolarGrid.Button.Primary"
                    android:text="@string/create_account" />

                <ProgressBar
                    android:id="@+id/pbLoading"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/text_primary"
                    android:translationZ="8dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- "or" divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/field_border" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_md"
                    android:text="@string/or_divider"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_small" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/field_border" />
            </LinearLayout>

            <!-- Social sign-up (UI only; the API supports NIC + password) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.SolarGrid.SocialButton"
                    android:contentDescription="@string/social_google"
                    android:src="@drawable/ic_google" />

                <ImageButton
                    android:id="@+id/btnMicrosoft"
                    style="@style/Widget.SolarGrid.SocialButton"
                    android:layout_marginStart="@dimen/space_lg"
                    android:contentDescription="@string/social_microsoft"
                    android:src="@drawable/ic_microsoft" />

                <ImageButton
                    android:id="@+id/btnApple"
                    style="@style/Widget.SolarGrid.SocialButton"
                    android:layout_marginStart="@dimen/space_lg"
                    android:contentDescription="@string/social_apple"
                    android:src="@drawable/ic_apple" />
            </LinearLayout>

            <!-- "Already have an account? Login Now" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/have_account_prefix"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/space_xs"
                    android:text="@string/login_now"
                    android:textColor="@color/accent_gold"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
