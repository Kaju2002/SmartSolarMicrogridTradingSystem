<?xml version="1.0" encoding="utf-8"?>
<!--
    File: item_station_card.xml
    Module: Station Management (Gabilan)
    Description: One station in the card carousel over the map. match_parent fills the
                 carousel minus its side padding, so the next card peeks in.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/station_card_gap"
    android:layout_marginTop="@dimen/space_sm"
    android:layout_marginEnd="@dimen/station_card_gap"
    android:layout_marginBottom="@dimen/space_md"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/home_card_radius"
    app:cardElevation="@dimen/station_card_elevation"
    app:strokeColor="@color/accent_gold"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Name and open/closed pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold"
                tools:text="Colombo Fort Solar Hub" />

            <TextView
                android:id="@+id/tvStationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/station_open_bg"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/station_open"
                android:textSize="@dimen/text_small"
                android:textStyle="bold"
                tools:text="@string/station_open_now" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStationHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_row_subtitle"
            tools:text="06:00 – 18:00" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider_soft" />

        <!-- Distance, price and free slots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_station_stat"
                    android:textStyle="bold"
                    tools:text="2.2 km" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/station_label_away"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_station_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_station_stat"
                    android:textStyle="bold"
                    tools:text="LKR 45" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/station_label_rate"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_station_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSlots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_station_stat"
                    android:textStyle="bold"
                    tools:text="3 of 5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/station_label_slots"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_station_label" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
