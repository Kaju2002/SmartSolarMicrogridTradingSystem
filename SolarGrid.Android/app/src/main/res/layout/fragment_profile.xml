<?xml version="1.0" encoding="utf-8"?>
<!--
    File: fragment_profile.xml
    Module: Identity and Access (Vithusha)
    Description: Profile tab. Avatar, name, NIC and account status, the details card
                 (phone, e-mail, member since), edit, logout and deactivate.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".auth.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/Widget.SolarGrid.ScreenTitle"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/profile_title" />

        <!-- Initials in a gold circle, name and NIC beside it -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_avatar"
                android:textStyle="bold"
                tools:text="KA" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_profile_name"
                    android:textStyle="bold"
                    tools:text="Kajanthan" />

                <TextView
                    android:id="@+id/tvProfileNic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    tools:text="NIC: 200012345678" />

                <!-- Account status; colour set in ProfileFragment -->
                <TextView
                    android:id="@+id/tvProfileStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="@color/station_open_bg"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/station_open"
                    android:textSize="@dimen/text_small"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Active"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Details card: filled from the API, "–" until then -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.SolarGrid.SectionLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/profile_section_details" />

            <ProgressBar
                android:id="@+id/pbProfile"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="@color/text_hint"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_soft"
            app:cardCornerRadius="@dimen/home_card_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs">

                <include
                    android:id="@+id/rowPhone"
                    layout="@layout/item_profile_info" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/home_row_divider_inset"
                    android:background="@color/divider_soft" />

                <include
                    android:id="@+id/rowEmail"
                    layout="@layout/item_profile_info" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/home_row_divider_inset"
                    android:background="@color/divider_soft" />

                <include
                    android:id="@+id/rowMemberSince"
                    layout="@layout/item_profile_info" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Shown when the details could not be loaded (offline, server down) -->
        <TextView
            android:id="@+id/tvProfileMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small"
            android:visibility="gone"
            tools:text="No internet connection. Showing the details saved on this phone."
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditProfile"
            style="@style/Widget.SolarGrid.Button.Primary"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/profile_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/logout"
            android:textColor="@color/text_primary"
            app:cornerRadius="@dimen/pill_radius"
            app:strokeColor="@color/accent_gold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_xl" />

        <!-- Kept away from the main buttons so it is not tapped by mistake -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeactivate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/profile_deactivate"
            android:textColor="@color/error_red" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/profile_deactivate_note"
            android:textColor="@color/text_hint"
            android:textSize="@dimen/text_small" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
