<?xml version="1.0" encoding="utf-8"?>
<!--
    File: fragment_operator_stations.xml
    Module: Verification and Dashboard (Aaron)
    Description: Grid Operator Stations tab: title and a pull-to-refresh list of the
                 stations assigned to the operator. One message area covers errors and no stations.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_sm"
    tools:context=".verification.operator.OperatorStationsFragment">

    <TextView
        style="@style/Widget.SolarGrid.ScreenTitle"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/operator_stations_title" />

    <TextView
        style="@style/Widget.SolarGrid.ScreenSubtitle"
        android:layout_marginStart="@dimen/screen_padding"
        android:text="@string/operator_stations_subtitle" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeOperatorStations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOperatorStations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/space_lg"
                tools:itemCount="3"
                tools:listitem="@layout/item_operator_station" />

            <ProgressBar
                android:id="@+id/progressOperatorStations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/accent_gold"
                android:visibility="gone" />

            <!-- No stations assigned, or a loading error -->
            <LinearLayout
                android:id="@+id/layoutOperatorStationsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/empty_icon_size"
                    android:layout_height="@dimen/empty_icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_solar_outlined"
                    app:tint="@color/text_hint" />

                <TextView
                    android:id="@+id/tvOperatorStationsEmpty"
                    style="@style/Widget.SolarGrid.EmptyText"
                    tools:text="@string/operator_home_no_station" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOperatorStationsRetry"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/bookings_retry"
                    android:textColor="@color/text_primary"
                    android:visibility="gone"
                    app:strokeColor="@color/field_border" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
