<?xml version="1.0" encoding="utf-8"?>
<!--
    File: fragment_profile.xml
    Module: Identity and Access (Vithusha)
    Description: Profile tab in a settings-list style: centred avatar, name, NIC and status,
                 a "Personal information" card (tap a row to edit) and an "Account" card
                 with Log out and Deactivate account.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".auth.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/screen_padding"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg">

        <TextView
            style="@style/Widget.SolarGrid.ScreenTitle"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/profile_title" />

        <!-- Initials in a gold circle with a pencil badge that opens the edit screen -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="@dimen/profile_avatar_size"
                android:layout_height="@dimen/profile_avatar_size"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_profile_avatar"
                android:textStyle="bold"
                tools:text="UK" />

            <ImageButton
                android:id="@+id/btnAvatarEdit"
                android:layout_width="@dimen/profile_avatar_badge"
                android:layout_height="@dimen/profile_avatar_badge"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_avatar_badge"
                android:contentDescription="@string/profile_edit"
                android:elevation="2dp"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_edit" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_profile_name"
            android:textStyle="bold"
            tools:text="U Kajanthan" />

        <TextView
            android:id="@+id/tvProfileRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/profile_role_prosumer"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Account status; colour set in ProfileFragment -->
        <TextView
            android:id="@+id/tvProfileStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/station_open_bg"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="@color/station_open"
            android:textSize="@dimen/text_small"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Active"
            tools:visibility="visible" />

        <!-- Personal information: filled from the API, "–" until then -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs">

            <TextView
                style="@style/Widget.SolarGrid.SectionLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/profile_section_personal" />

            <ProgressBar
                android:id="@+id/pbProfile"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:indeterminateTint="@color/text_hint"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEditDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="sans-serif-medium"
                android:padding="@dimen/space_xs"
                android:text="@string/profile_edit_link"
                android:textColor="@color/booking_pending"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_soft"
            app:cardCornerRadius="@dimen/profile_card_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowName"
                    layout="@layout/item_profile_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/space_md"
                    android:background="@color/divider_soft" />

                <include
                    android:id="@+id/rowPhone"
                    layout="@layout/item_profile_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/space_md"
                    android:background="@color/divider_soft" />

                <include
                    android:id="@+id/rowEmail"
                    layout="@layout/item_profile_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/space_md"
                    android:background="@color/divider_soft" />

                <include
                    android:id="@+id/rowNic"
                    layout="@layout/item_profile_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/space_md"
                    android:background="@color/divider_soft" />

                <include
                    android:id="@+id/rowMemberSince"
                    layout="@layout/item_profile_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Shown when the details could not be loaded (offline, server down) -->
        <TextView
            android:id="@+id/tvProfileMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small"
            android:visibility="gone"
            tools:text="No internet connection. Showing the details saved on this phone."
            tools:visibility="visible" />

        <!-- Account actions -->
        <TextView
            style="@style/Widget.SolarGrid.SectionLabel"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/profile_section_account" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_soft"
            app:cardCornerRadius="@dimen/profile_card_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowLogout"
                    layout="@layout/item_profile_action" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/divider_soft" />

                <include
                    android:id="@+id/rowDeactivate"
                    layout="@layout/item_profile_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            android:text="@string/profile_deactivate_note"
            android:textColor="@color/text_hint"
            android:textSize="@dimen/text_small" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
