<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_forgot_password.xml
    Module: Identity and Access
    Description: Forgot password in three steps on one screen: e-mail, 4-digit code,
                 new password. Same hero and pill fields as the sign-in screen.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".auth.ForgotPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero image with the white step edge, and a round back button over it.
             Back button top margin (status bar) is set in code. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_hero_height">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/img_forgot_hero" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/login_hero_edge_height"
                android:layout_gravity="bottom"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/bg_hero_step" />

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/hero_back_button_size"
                android:layout_height="@dimen/hero_back_button_size"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_white_circle"
                android:contentDescription="@string/forgot_back"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <!-- Changes with the step; the code step names the masked e-mail -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body"
                tools:text="@string/forgot_email_subtitle" />

            <!-- Step 1: e-mail -->
            <LinearLayout
                android:id="@+id/layoutStepEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.SolarGrid.FieldLabel"
                    android:layout_marginTop="@dimen/space_lg"
                    android:labelFor="@id/etEmail"
                    android:text="@string/email_label" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SolarGrid.TextInputLayout.Pill"
                    android:layout_marginTop="@dimen/space_sm"
                    app:startIconDrawable="@drawable/ic_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        style="@style/Widget.SolarGrid.EditText.Pill"
                        android:autofillHints="emailAddress"
                        android:hint="@string/email_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Step 2: four code boxes; typing moves to the next box, delete goes back -->
            <LinearLayout
                android:id="@+id/layoutStepCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/etCode1"
                    style="@style/Widget.SolarGrid.OtpBox"
                    android:autofillHints="smsOTPCode" />

                <Space
                    android:layout_width="@dimen/otp_box_gap"
                    android:layout_height="0dp" />

                <EditText
                    android:id="@+id/etCode2"
                    style="@style/Widget.SolarGrid.OtpBox" />

                <Space
                    android:layout_width="@dimen/otp_box_gap"
                    android:layout_height="0dp" />

                <EditText
                    android:id="@+id/etCode3"
                    style="@style/Widget.SolarGrid.OtpBox" />

                <Space
                    android:layout_width="@dimen/otp_box_gap"
                    android:layout_height="0dp" />

                <EditText
                    android:id="@+id/etCode4"
                    style="@style/Widget.SolarGrid.OtpBox"
                    android:imeOptions="actionDone" />
            </LinearLayout>

            <!-- Step 3: new password twice, both hidden with an eye toggle -->
            <LinearLayout
                android:id="@+id/layoutStepReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.SolarGrid.FieldLabel"
                    android:layout_marginTop="@dimen/space_lg"
                    android:labelFor="@id/etNewPassword"
                    android:text="@string/forgot_new_password_label" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SolarGrid.TextInputLayout.Pill"
                    android:layout_marginTop="@dimen/space_sm"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNewPassword"
                        style="@style/Widget.SolarGrid.EditText.Pill"
                        android:autofillHints="newPassword"
                        android:hint="@string/forgot_new_password_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.SolarGrid.FieldLabel"
                    android:layout_marginTop="@dimen/space_md"
                    android:labelFor="@id/etConfirmPassword"
                    android:text="@string/confirm_password_label" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SolarGrid.TextInputLayout.Pill"
                    android:layout_marginTop="@dimen/space_sm"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmPassword"
                        style="@style/Widget.SolarGrid.EditText.Pill"
                        android:autofillHints="newPassword"
                        android:hint="@string/confirm_password_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textColor="@color/error_red"
                android:textSize="@dimen/text_small"
                android:visibility="gone"
                tools:text="Enter a valid e-mail address."
                tools:visibility="visible" />

            <!-- One gold button; its text follows the step -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrimary"
                style="@style/Widget.SolarGrid.Button.Primary"
                android:layout_marginTop="@dimen/space_lg"
                tools:text="@string/forgot_send_email" />

            <!-- Code step only: counts down, then becomes a link -->
            <TextView
                android:id="@+id/tvResend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/space_xs"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_body"
                android:visibility="gone"
                tools:text="Resend code in 30s"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
