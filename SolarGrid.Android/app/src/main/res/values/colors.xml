<?xml version="1.0" encoding="utf-8"?>
<!-- App colour palette (same tokens as the web portal and the old prosumer design) -->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Brand -->
    <color name="accent_gold">#FFFFCC00</color>
    <color name="primary_blue">#FF4D7CFF</color>
    <color name="primary_blue_dark">#FF3A63D9</color>

    <!-- Text -->
    <color name="text_primary">#FF111111</color>
    <color name="text_secondary">#FF333333</color>
    <color name="text_hint">#FF9A9A9A</color>

    <!-- Inputs and surfaces -->
    <color name="field_border">#FFD5D5D5</color>
    <color name="surface_disabled">#FFE8E8E8</color>
    <color name="ripple_dark">#1F000000</color>

    <!-- Home: hero sky (matches the top edge of the render, warm left to blue right), chip,
         tip card, grouped list -->
    <color name="home_sky_left">#FFF2F1EC</color>
    <color name="home_sky_mid">#FFDCE5EC</color>
    <color name="home_sky_right">#FFCADCE8</color>
    <color name="home_hero_chip_bg">#B3FFFFFF</color>
    <color name="home_hero_chip_stroke">#14000000</color>
    <color name="home_hero_chip_icon">#FFE0A100</color>
    <color name="home_tip_bg">#FFFFF1C4</color>
    <color name="surface_soft">#FFF6F6F4</color>
    <color name="divider_soft">#FFE6E6E3</color>

    <!-- Station open/closed pill -->
    <color name="station_open">#FF1E7F3A</color>
    <color name="station_open_bg">#FFE3F4E8</color>
    <color name="station_closed">#FF5F6368</color>
    <color name="station_closed_bg">#FFEDEDED</color>
    <color name="station_closed_pin">#FFC7C9CC</color>

    <!-- Booking status pill (Approved reuses station_open, Cancelled station_closed) -->
    <color name="booking_pending">#FF8A6A00</color>
    <color name="booking_pending_bg">#FFFFF4D4</color>
    <color name="booking_completed">#FF3A63D9</color>
    <color name="booking_completed_bg">#FFE7EDFA</color>

    <!-- Feedback -->
    <color name="error_red">#FFD32F2F</color>
    <color name="error_red_bg">#FFFDECEC</color>

    <!-- Dark band over the camera so white text stays readable -->
    <color name="scan_scrim">#99000000</color>
</resources>
