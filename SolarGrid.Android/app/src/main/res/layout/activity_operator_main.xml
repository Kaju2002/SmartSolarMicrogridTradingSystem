<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_operator_main.xml
    Module: Verification and Dashboard (Aaron)
    Description: Grid Operator shell. Tab fragments swap inside the container; bottom nav switches tabs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".verification.operator.OperatorMainActivity">

    <!-- Status bar padding is added in code (edge-to-edge) -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/field_border" />

    <!-- Adds the gesture bar padding by itself -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.SolarGrid.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_operator_nav" />
</LinearLayout>
