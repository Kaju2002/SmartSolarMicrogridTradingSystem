<?xml version="1.0" encoding="utf-8"?>
<!--
    File: item_home_row.xml
    Module: Team
    Description: One tappable row in the "Your SolarGrid" list
                 (icon tile, title, subtitle, arrow). Content is set in HomeFragment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/home_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_md"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/space_md"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="@dimen/home_row_icon_tile"
        android:layout_height="@dimen/home_row_icon_tile"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/ivRowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/text_primary"
            tools:src="@drawable/ic_calendar_outlined" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_row_title"
            tools:text="My bookings" />

        <TextView
            android:id="@+id/tvRowSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_hint"
            android:textSize="@dimen/text_row_subtitle"
            tools:text="View and manage your slots" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_hint" />
</LinearLayout>
