<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_login.xml
    Module: Identity and Access (Vithusha)
    Description: Sign-in screen for Prosumers (NIC) and Grid Operators (username).
                 Hero image with a wave edge on top, then the sign-in form.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".auth.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero image; the white step edge sits on its bottom (Figma shape) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_hero_height">

            <ImageView
                android:id="@+id/ivHero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/img_login_hero" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/login_hero_edge_height"
                android:layout_gravity="bottom"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/bg_hero_step" />
        </FrameLayout>

        <!-- Sign-in form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/login_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <!-- NIC (Prosumer) or username (Operator) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:fontFamily="sans-serif-medium"
                android:labelFor="@id/etIdentifier"
                android:text="@string/identifier_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilIdentifier"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:boxCornerRadiusBottomEnd="@dimen/pill_radius"
                app:boxCornerRadiusBottomStart="@dimen/pill_radius"
                app:boxCornerRadiusTopEnd="@dimen/pill_radius"
                app:boxCornerRadiusTopStart="@dimen/pill_radius"
                app:boxStrokeColor="@color/selector_input_stroke"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="@color/text_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etIdentifier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/identifier_hint"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password with show/hide eye icon -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:fontFamily="sans-serif-medium"
                android:labelFor="@id/etPassword"
                android:text="@string/password_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:boxCornerRadiusBottomEnd="@dimen/pill_radius"
                app:boxCornerRadiusBottomStart="@dimen/pill_radius"
                app:boxCornerRadiusTopEnd="@dimen/pill_radius"
                app:boxCornerRadiusTopStart="@dimen/pill_radius"
                app:boxStrokeColor="@color/selector_input_stroke"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_hint"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/text_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Shown only when login fails; LoginActivity sets text and visibility -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textColor="@color/error_red"
                android:textSize="@dimen/text_small"
                android:visibility="gone"
                tools:text="Invalid credentials"
                tools:visibility="visible" />

            <!-- Button and spinner share one spot; spinner replaces the text while loading -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignIn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:backgroundTint="@color/selector_button_primary_bg"
                    android:text="@string/sign_in"
                    android:textColor="@color/selector_button_primary_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/pill_radius" />

                <ProgressBar
                    android:id="@+id/pbLoading"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/text_primary"
                    android:translationZ="8dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- "or" divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/field_border" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_md"
                    android:text="@string/or_divider"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_small" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/field_border" />
            </LinearLayout>

            <!-- Social sign-in (UI only; the API supports NIC/username + password) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnGoogle"
                    android:layout_width="@dimen/social_button_size"
                    android:layout_height="@dimen/social_button_size"
                    android:background="@drawable/bg_social_circle"
                    android:contentDescription="@string/social_google"
                    android:padding="@dimen/space_md"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_google" />

                <ImageButton
                    android:id="@+id/btnMicrosoft"
                    android:layout_width="@dimen/social_button_size"
                    android:layout_height="@dimen/social_button_size"
                    android:layout_marginStart="@dimen/space_lg"
                    android:background="@drawable/bg_social_circle"
                    android:contentDescription="@string/social_microsoft"
                    android:padding="@dimen/space_md"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_microsoft" />

                <ImageButton
                    android:id="@+id/btnApple"
                    android:layout_width="@dimen/social_button_size"
                    android:layout_height="@dimen/social_button_size"
                    android:layout_marginStart="@dimen/space_lg"
                    android:background="@drawable/bg_social_circle"
                    android:contentDescription="@string/social_apple"
                    android:padding="@dimen/space_md"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_apple" />
            </LinearLayout>

            <!-- "Don't have an account? Register Now" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_account_prefix"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/space_xs"
                    android:text="@string/register_now"
                    android:textColor="@color/accent_gold"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
