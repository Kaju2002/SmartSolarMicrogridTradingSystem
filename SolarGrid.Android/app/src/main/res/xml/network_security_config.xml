<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP allowed only for the local dev API; everything else must be HTTPS -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator alias for the host PC -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Host PC on the local Wi-Fi, for a real phone -->
        <domain includeSubdomains="false">192.168.1.250</domain>
    </domain-config>
</network-security-config>
