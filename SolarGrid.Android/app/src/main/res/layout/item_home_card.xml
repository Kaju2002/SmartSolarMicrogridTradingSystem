<?xml version="1.0" encoding="utf-8"?>
<!--
    File: item_home_card.xml
    Module: Team
    Description: One feature card on the home screen (full-width 3D image on top,
                 title with an arrow, subtitle). Content is set in HomeFragment.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/home_card_width"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/home_card_radius"
    app:cardElevation="0dp"
    app:rippleColor="@color/ripple_dark"
    app:strokeColor="@color/divider_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The card clips this to its rounded top corners -->
        <ImageView
            android:id="@+id/ivCardImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_card_image"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            tools:src="@drawable/img_home_find" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_card_title"
                    tools:text="Find stations" />

                <!-- Small round arrow next to the title -->
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="@drawable/bg_home_card_arrow"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCardSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lines="2"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_card_subtitle"
                tools:text="Solar hubs near you" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
