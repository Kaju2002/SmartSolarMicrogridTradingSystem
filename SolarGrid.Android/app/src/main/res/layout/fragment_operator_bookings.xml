<?xml version="1.0" encoding="utf-8"?>
<!--
    File: fragment_operator_bookings.xml
    Module: Verification and Dashboard (Aaron)
    Description: Grid Operator Bookings tab: bookings at the operator's stations.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/screen_padding"
    tools:context=".verification.operator.OperatorBookingsFragment">

    <TextView
        style="@style/Widget.SolarGrid.ScreenTitle"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/operator_bookings_title" />

    <TextView
        style="@style/Widget.SolarGrid.ScreenSubtitle"
        android:text="@string/operator_bookings_subtitle" />
</LinearLayout>
