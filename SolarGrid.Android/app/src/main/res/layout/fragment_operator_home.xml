<?xml version="1.0" encoding="utf-8"?>
<!--
    File: fragment_operator_home.xml
    Module: Verification and Dashboard (Aaron)
    Description: Grid Operator Home tab: greeting, assigned stations and the Scan QR button.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeOperatorHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".verification.operator.OperatorHomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                android:id="@+id/tvOperatorGreeting"
                style="@style/Widget.SolarGrid.ScreenTitle"
                android:layout_marginTop="@dimen/space_xl"
                tools:text="Hi, Nimal" />

            <TextView
                android:id="@+id/tvOperatorStations"
                style="@style/Widget.SolarGrid.ScreenSubtitle"
                android:layout_width="match_parent"
                tools:text="Malabe Solar Station" />

            <!-- Main action: verify a prosumer at the station -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanQr"
                style="@style/Widget.SolarGrid.Button.Primary"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/operator_home_scan"
                app:icon="@drawable/ic_qr_scan"
                app:iconGravity="textStart"
                app:iconTint="@color/text_primary" />

            <!-- Loading error; pull down to retry -->
            <TextView
                android:id="@+id/tvOperatorHomeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textColor="@color/error_red"
                android:textSize="@dimen/text_small"
                android:visibility="gone"
                tools:text="No internet connection. Pull down to try again."
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
