<?xml version="1.0" encoding="utf-8"?>
<!--
    File: item_operator_station.xml
    Module: Verification and Dashboard (Aaron)
    Description: One station assigned to the Grid Operator: name, open/closed pill, hours,
                 capacity, rate and free slots, and the booking counts at the station.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/home_card_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Name and open / closed / deactivated pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOperatorStationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold"
                tools:text="Malabe Solar Hub" />

            <TextView
                android:id="@+id/tvOperatorStationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/station_open_bg"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/station_open"
                android:textSize="@dimen/text_small"
                android:textStyle="bold"
                tools:text="@string/station_open_now" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOperatorStationHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="@dimen/space_sm"
            android:gravity="center_vertical"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_row_subtitle"
            app:drawableStartCompat="@drawable/ic_schedule"
            app:drawableTint="@color/text_hint"
            tools:text="06:00 – 18:00" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider_soft" />

        <!-- Capacity, rate and free slots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOperatorStationCapacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_station_stat"
                    android:textStyle="bold"
                    tools:text="120 kWh" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/operator_station_label_capacity"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_station_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOperatorStationRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_station_stat"
                    android:textStyle="bold"
                    tools:text="LKR 45" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/station_label_rate"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_station_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOperatorStationSlots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_station_stat"
                    android:textStyle="bold"
                    tools:text="3 of 5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/station_label_slots"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_station_label" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hidden when the bookings couldn't be loaded -->
        <TextView
            android:id="@+id/tvOperatorStationBookings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_info_tile"
            android:drawablePadding="@dimen/space_sm"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_row_subtitle"
            app:drawableStartCompat="@drawable/ic_calendar_outlined"
            app:drawableTint="@color/text_hint"
            tools:text="2 pending · 1 approved today" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
