<?xml version="1.0" encoding="utf-8"?>
<!-- Shared widget styles so login, register and later forms look the same -->
<resources>

    <!-- Bold label above a form field -->
    <style name="Widget.SolarGrid.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Pill-shaped outlined field: gold border on focus, no floating hint -->
    <style name="Widget.SolarGrid.TextInputLayout.Pill" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">@dimen/pill_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/pill_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/pill_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/pill_radius</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">@color/text_hint</item>
        <item name="endIconTint">@color/text_hint</item>
    </style>

    <!-- Text inside a pill field -->
    <style name="Widget.SolarGrid.EditText.Pill" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Gold pill button (Sign In, Create Account); greys out when disabled -->
    <style name="Widget.SolarGrid.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="backgroundTint">@color/selector_button_primary_bg</item>
        <item name="android:textColor">@color/selector_button_primary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/pill_radius</item>
    </style>

    <!-- Round Google / Microsoft / Apple button -->
    <style name="Widget.SolarGrid.SocialButton" parent="">
        <item name="android:layout_width">@dimen/social_button_size</item>
        <item name="android:layout_height">@dimen/social_button_size</item>
        <item name="android:background">@drawable/bg_social_circle</item>
        <item name="android:padding">@dimen/space_md</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Big bold heading at the top of each tab screen -->
    <style name="Widget.SolarGrid.ScreenTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- One-line description under a screen title -->
    <style name="Widget.SolarGrid.ScreenSubtitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Grey icon + text shown when a list has nothing yet -->
    <style name="Widget.SolarGrid.EmptyText" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Small grey caps heading above a group, e.g. "YOUR SOLARGRID" -->
    <style name="Widget.SolarGrid.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">@dimen/text_section_label</item>
    </style>

    <!-- White bottom nav with labels always shown and a gold pill behind the selected icon -->
    <style name="Widget.SolarGrid.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.SolarGrid.BottomNav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.SolarGrid.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.SolarGrid.NavLabel</item>
    </style>

    <!-- Bottom nav labels: a bit larger than the default, bold when selected -->
    <style name="TextAppearance.SolarGrid.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_nav_label</item>
    </style>

    <style name="TextAppearance.SolarGrid.NavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Gold pill for the selected tab -->
    <style name="Widget.SolarGrid.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_gold</item>
    </style>
</resources>
