<?xml version="1.0" encoding="utf-8"?>
<!-- Identity and Access: forgot password texts (e-mail, code, new password steps) -->
<resources>
    <string name="forgot_link">Forgot password?</string>
    <string name="forgot_title">Forgot Password</string>
    <string name="forgot_back">Back</string>

    <!-- Step 1: e-mail -->
    <string name="forgot_email_subtitle">Enter the e-mail on your account to get a 4-digit code.</string>
    <string name="forgot_send_email">Send Email</string>
    <string name="forgot_error_email">Enter a valid e-mail address.</string>

    <!-- Step 2: code -->
    <string name="forgot_code_subtitle">Please enter the 4-digit code sent to %1$s</string>
    <string name="forgot_code_digit">Code digit %1$d</string>
    <string name="forgot_verify">Verify</string>
    <string name="forgot_resend">Resend code</string>
    <string name="forgot_resend_in">Resend code in %1$ds</string>
    <string name="forgot_error_code">Enter all 4 digits of the code.</string>

    <!-- Step 3: new password -->
    <string name="forgot_reset_subtitle">Create a new password for your account.</string>
    <string name="forgot_new_password_label">New password</string>
    <string name="forgot_new_password_hint">Input new password</string>
    <string name="forgot_save_password">Save Password</string>
    <string name="forgot_error_password_empty">Enter and confirm your new password.</string>
    <string name="forgot_error_password_short">Password must be at least %1$d characters.</string>

    <!-- The API has no reset endpoint yet, so the last step says so instead of pretending -->
    <string name="forgot_not_live">Password reset is not connected to the server yet. Please contact support to reset your password.</string>
</resources>
