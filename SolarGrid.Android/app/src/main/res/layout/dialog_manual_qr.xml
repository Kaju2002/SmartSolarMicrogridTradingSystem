<?xml version="1.0" encoding="utf-8"?>
<!--
    File: dialog_manual_qr.xml
    Module: Verification and Dashboard (Aaron)
    Description: Text field for typing a booking's QR code when the camera can't read it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_lg"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/space_lg">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilManualCode"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/scan_manual_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etManualCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
